#!/usr/bin/env python3
"""Minimal yt-dlp test double.

Records the arguments ipod-fetch.sh built and writes a file where the real
thing would have written one, so the suite can assert on the flags without
reaching the network.

It answers a search as well as a download, because the app makes both calls
and they are different programs: a download writes a file and prints where it
landed, while a search prints one JSON object per line and downloads nothing.
Told apart by --dump-json, which only the search passes.

The two options a distribution package may be too old to have are separately
switchable, because they arrived years apart and the fallbacks differ. So is
the search failing, which is the one thing a caller cannot tell from an empty
answer: yt-dlp exits non-zero when it could not reach YouTube and zero with
nothing printed when the query simply found nothing.
"""

import json
import os
import sys


args = sys.argv[1:]

if "--version" in args:
    print("0000.00.00")
    raise SystemExit(0)

if "--help" in args:
    if os.environ.get("FAKE_YTDLP_SUPPORTS_JS_RUNTIMES", "1") != "0":
        print("    --js-runtimes RUNTIME[:PATH]")
    if os.environ.get("FAKE_YTDLP_SUPPORTS_PRINT_TO_FILE", "1") != "0":
        print("    --print-to-file [WHEN:]TEMPLATE FILE")
    raise SystemExit(0)


def value_of(flag, offset=1):
    return args[args.index(flag) + offset] if flag in args else None


if "--dump-json" in args:
    if os.environ.get("FAKE_YTDLP_SEARCH_FAILS") == "1":
        print("ERROR: unable to reach YouTube", file=sys.stderr)
        raise SystemExit(1)
    # The last argument is what the app asked for: "ytsearchN:some words" for
    # a query, or the link itself when one was pasted.
    target = args[-1]
    query = target.split(":", 1)[1] if target.startswith("ytsearch") else target
    print(
        json.dumps(
            {
                "id": "testvideo",
                "title": f"Test Track ({query})",
                "uploader": "Test Artist",
                "duration": 180,
                "webpage_url": "https://www.youtube.com/watch?v=testvideo",
                "thumbnails": [
                    {
                        "url": "https://i.ytimg.com/vi/testvideo/hqdefault.jpg",
                        "width": 480,
                        "height": 360,
                    }
                ],
            }
        )
    )
    raise SystemExit(0)


with open(os.environ["FAKE_YTDLP_RECORD"], "w", encoding="utf-8") as fh:
    json.dump(args, fh, indent=2)

# "<dir>/%(artist,uploader)s/%(track,title)s [%(id)s].%(ext)s" -> "<dir>"
template = value_of("--output")
if template is None:
    raise SystemExit("ipod-fetch.sh did not pass an output template")
base = template.split("/%(")[0]

archive = value_of("--download-archive")

# Already fetched once, so the real thing would skip it and no postprocessor
# would run. That is the difference between "nothing new" and "downloaded
# nothing", which decides whether anything gets copied onto the iPod.
if archive and os.path.exists(archive):
    with open(archive, encoding="utf-8") as fh:
        if "youtube testvideo" in fh.read():
            print("[download] testvideo has already been recorded in the archive")
            raise SystemExit(0)

# Name the output after the format actually requested, so the fake cannot keep
# claiming to produce a container the tool stopped asking for.
ext = value_of("--audio-format") or "mp3"
track = os.path.join(base, "Test Artist", f"Test Track [testvideo].{ext}")
os.makedirs(os.path.dirname(track), exist_ok=True)
with open(track, "w", encoding="utf-8") as fh:
    fh.write(f"fake {ext} payload\n")

if archive:
    with open(archive, "a", encoding="utf-8") as fh:
        fh.write("youtube testvideo\n")

# The real thing appends one line per download after the file reaches its
# final name, which is what makes the path usable by whatever runs next.
if value_of("--print-to-file") == "after_move:filepath":
    with open(value_of("--print-to-file", 2), "a", encoding="utf-8") as fh:
        fh.write(track + "\n")

print(f"[ExtractAudio] Destination: {track}")
