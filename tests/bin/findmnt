#!/usr/bin/env python3
"""Minimal findmnt test double used to render the GUI with a fake volume."""

import json
import os
import sys


# Several mounts are listed the way the real findmnt lists them, because a
# machine with an iPod plugged in has other vfat volumes on it too.
#
# Set to nothing is an empty bus, which is how a suite that puts this double on
# PATH for every one of its runs asks for no device without reading whatever
# the developer happens to have plugged in. Never set at all is still the
# KeyError it always was: a harness that stopped exporting the variable would
# otherwise go on rendering and asserting against "No iPod connected" rather
# than saying its fixture had gone.
mount_points = [
    path for path in os.environ["FAKE_IPOD_MOUNT"].split(os.pathsep) if path
]
if "--json" in sys.argv:
    print(json.dumps({"filesystems": [{"target": path} for path in mount_points]}))
elif "--target" in sys.argv:
    print("/dev/sdz")
else:
    raise SystemExit(f"unsupported findmnt arguments: {sys.argv[1:]}")
